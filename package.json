{
  "name": "cloud-computing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cloud-computing/api dev",
    "dev:debug": "pnpm --filter @cloud-computing/api dev:debug",
    "dev:web": "pnpm --filter @cloud-computing/web dev",
    "build": "pnpm --recursive build",
    "typecheck:web": "pnpm --filter @cloud-computing/web typecheck",
    "start": "pnpm --filter @cloud-computing/api start",
    "db:migrate": "pnpm --filter @cloud-computing/api db:migrate",
    "db:revert": "pnpm --filter @cloud-computing/api db:revert",
    "db:seed": "pnpm --filter @cloud-computing/api db:seed",
    "test": "pnpm --recursive test",
    "test:cov": "pnpm --recursive test:cov",
    "test:e2e": "pnpm --filter @cloud-computing/api test:e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    }
  }
}
